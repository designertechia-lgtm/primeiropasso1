# ============================================================================
# Frontend (Vite) — Primeiro Passo
# ============================================================================
# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local fica no .gitignore e NUNCA deve ser commitado.
# Em produção (EasyPanel/Vercel), defina estas variáveis no painel do serviço.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
# URL pública do projeto Supabase (não é segredo)
VITE_SUPABASE_URL=https://lpqkkbtadnqkbathdvzb.supabase.co

# Anon key (JWT) — protegida por RLS, segura para uso em frontend
# Atualmente hardcoded em src/integrations/supabase/client.ts (TODO: migrar pra cá)
# Obter em: app.supabase.com → projeto → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=

# ── Endpoints internos ──────────────────────────────────────────────────────
# RAG worker para ingestão de documentos
# Dev:  http://localhost:8000/rag/ingest
# Prod: https://worker.primeiropasso.online/rag/ingest
VITE_RAG_INGEST_URL=https://worker.primeiropasso.online/rag/ingest

# Backend de geração de vídeo (FastAPI Veo/Kling)
# Dev:  http://localhost:8001
# Prod: https://video-api.primeiropasso.online
VITE_VIDEO_API_URL=https://video-api.primeiropasso.online
