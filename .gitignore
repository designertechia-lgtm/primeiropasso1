# Environment variables (contain API keys — never commit)
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.obsidian/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
# settings locais do Claude ficam de fora, MAS as skills do projeto são versionadas
# (pra viajar pro claude.ai/code em auditorias remotas)
.claude/*
!.claude/skills/
_docs/

# Supabase CLI: cache local de versao + temp files (nao e codigo do projeto)
supabase/.temp/

# Lockfile do Deno gerado pelo editor (as edge functions rodam em Deno) —
# artefato local, nao usado pelo build/deploy. Mantido fora do repo.
deno.lock

# Python (worker-primeiropasso): bytecode cache
__pycache__/
*.pyc
*.pyo

# Arquivo local de versoes do CORE_RULES (fica fora do repo, em PrimeiroPassoProjeto/)
CORE_RULES_versoes/
