# ============================================================================
# worker-primeiropasso — RAG ingestion + WhatsApp bot via Evolution API
# ============================================================================
# Copie este arquivo para .env e preencha com valores reais.
# Em produção (EasyPanel), definir como Environment Variables do serviço.
# ============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxx.supabase.co

# Service role key — server-side, acesso FULL ao banco
# Settings → API → service_role
SUPABASE_SERVICE_KEY=eyJ...

# ── IA ──────────────────────────────────────────────────────────────────────
# Anthropic (Claude): chat do agente + Vision (analise de imagem)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI: embeddings (RAG) + Whisper (transcricao de audio)
# Obrigatorio — Anthropic nao oferece embeddings nem transcricao.
OPENAI_API_KEY=sk-...

# ── WhatsApp (Evolution API) ────────────────────────────────────────────────
# URL da instância Evolution rodando no EasyPanel
EVOLUTION_API_URL=http://localhost:8080
# Token de autenticação da Evolution
EVOLUTION_API_KEY=your-evolution-key

# ── Infraestrutura ──────────────────────────────────────────────────────────
# Redis para fila de jobs e anti-flood
REDIS_URL=redis://localhost:6379

# Anti-flood: segundos mínimos entre mensagens (não-secreto)
ANTI_FLOOD_SECONDS=3
